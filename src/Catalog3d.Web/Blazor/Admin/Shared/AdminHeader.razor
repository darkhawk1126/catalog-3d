@namespace Catalog3d.Web.Blazor.Admin.Shared

@* App-bar header: catalog·3d wordmark on the left, authenticated user on the right. *@

<div class="c3d-header-inner">
    <a href="/" class="c3d-wordmark" title="catalog·3d dashboard">
        <span class="c3d-wordmark-catalog">catalog</span>
        <span class="c3d-wordmark-sep">·</span>
        <span class="c3d-wordmark-3d">3d</span>
    </a>

    <div class="c3d-header-right">
        <AuthorizeView>
            <Authorized>
                <div class="c3d-user-chip">
                    <FluentIcon Value="@(new Size16.Person())" Class="c3d-user-chip-icon" />
                    <span class="c3d-user-chip-name">@context.User.Identity?.Name</span>
                </div>
            </Authorized>
            <NotAuthorized>
                <FluentAnchor Href="/login/dev" Appearance="Appearance.Accent">Sign in</FluentAnchor>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>
