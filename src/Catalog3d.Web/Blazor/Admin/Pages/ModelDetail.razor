@page "/models/{Slug}"
@namespace Catalog3d.Web.Blazor.Admin.Pages

<PageTitle>@(_model?.Name ?? Slug) — catalog-3d</PageTitle>

@if (_loading)
{
    <div style="display: flex; justify-content: center; padding: 4rem;">
        <FluentProgressRing Style="width: 36px; height: 36px;" />
    </div>
}
else if (_model is null)
{
    <div class="c3d-empty-state" style="margin-top: 2rem;">
        <div class="c3d-empty-state-icon"><FluentIcon Value="@(new Size48.Cube())" /></div>
        <p class="c3d-empty-state-title">Model not found</p>
        <p class="c3d-empty-state-desc">This model doesn't exist or you don't have access.</p>
        <FluentAnchor Href="/collections" Appearance="Appearance.Accent">Back to Collections</FluentAnchor>
    </div>
}
else
{
    @* Page header *@
    <div class="c3d-page-header">
        <div class="model-header-left">
            <nav class="c3d-breadcrumb">
                <a href="/collections">Collections</a>
                <span class="c3d-breadcrumb-sep">/</span>
                <a href="/collections/@(_collection?.Slug)">@(_collection?.Name ?? "Collection")</a>
                <span class="c3d-breadcrumb-sep">/</span>
                <span class="c3d-breadcrumb-current">@_model.Name</span>
            </nav>
            <h1 class="c3d-page-title">@_model.Name</h1>
        </div>
        <div class="model-header-actions">
            @if (_isAdmin)
            {
                <FluentButton Appearance="Appearance.Outline"
                              IconStart="@(new Size16.ArrowSync())"
                              Loading="@_retriggering"
                              Disabled="@_retriggering"
                              OnClick="@RetriggerRenderAsync">
                    Re-render
                </FluentButton>
                <FluentButton Appearance="Appearance.Outline"
                              IconStart="@(new Size16.Delete())"
                              Disabled="@_deleting"
                              Loading="@_deleting"
                              OnClick="@DeleteModelAsync">
                    Delete
                </FluentButton>
            }
        </div>
    </div>

    @* Two-column layout *@
    <div class="model-layout">
        @* Left: thumbnail + viewer link *@
        <div class="model-thumb-col">
            <div class="model-thumb-wrap">
                @if (_thumbnailAvailable)
                {
                    <img src="/api/v1/models/@Slug/thumbnail"
                         alt="@_model.Name thumbnail"
                         class="model-thumb-img" />
                }
                else
                {
                    <div class="model-thumb-empty">
                        <FluentIcon Value="@(new Size48.Cube())" />
                        <span class="meta-mono" style="font-size: 0.7rem; text-align: center;">
                            @(_model.Status == ModelStatus.Processing ? "Rendering thumbnail…" :
                              _model.Status == ModelStatus.Failed ? "Render failed" : "No thumbnail")
                        </span>
                    </div>
                }
            </div>

            @* Viewer link — Download-gated, shown only to Download+ callers *@
            @if (_canDownload && _stlFiles.Count > 0)
            {
                <div class="model-viewer-links">
                    @foreach (var stl in _stlFiles)
                    {
                        <FluentAnchor Href="@($"/viewer/{stl.Id}")"
                                      Target="_blank"
                                      Appearance="Appearance.Accent"
                                      Style="width: 100%; justify-content: center;">
                            <FluentIcon Value="@(new Size20.CubeMultiple())" Style="margin-right: 6px;" />
                            Open 3D Viewer
                        </FluentAnchor>
                    }
                </div>
            }
        </div>

        @* Right: metadata + file list *@
        <div class="model-meta-col">
            @* Model metadata *@
            <div class="col-meta-card" style="margin-bottom: 1.5rem;">
                <div class="c3d-meta-row">
                    <span class="c3d-meta-key">Status</span>
                    <span class="@ModelStatusPillClass(_model.Status)">@_model.Status</span>
                </div>
                <div class="c3d-meta-row">
                    <span class="c3d-meta-key">Slug</span>
                    <code>@_model.Slug</code>
                </div>
                <div class="c3d-meta-row">
                    <span class="c3d-meta-key">Owner</span>
                    <span class="c3d-meta-val">@_model.Owner</span>
                </div>
                <div class="c3d-meta-row">
                    <span class="c3d-meta-key">Uploaded</span>
                    <span class="c3d-meta-val">@_model.CreatedAt.ToLocalTime().ToString("g")</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(_model.Description))
                {
                    <div class="c3d-meta-row">
                        <span class="c3d-meta-key">Description</span>
                        <span class="c3d-meta-val">@_model.Description</span>
                    </div>
                }
            </div>

            @* File list — Download-gated geometry info *@
            @if (_canDownload && _stlFiles.Count > 0)
            {
                <span class="c3d-section-label">Files</span>

                <div class="files-table-wrap">
                    <FluentDataGrid Items="@_stlFiles.AsQueryable()" TGridItem="Catalog3d.Domain.Entities.ModelFile">
                        <TemplateColumn Title="File ID">
                            <code class="meta-mono" style="font-size: 0.7rem;">@context.Id.ToString("D")[..8]…</code>
                        </TemplateColumn>
                        <TemplateColumn Title="Size">
                            <span class="meta-mono">@FormatSize(context.Size)</span>
                        </TemplateColumn>
                        <TemplateColumn Title="Triangles">
                            <span class="meta-mono">@(context.TriCount.HasValue ? context.TriCount.Value.ToString("N0") : "—")</span>
                        </TemplateColumn>
                        <TemplateColumn Title="Bounding Box">
                            <span class="meta-mono" style="font-size: 0.75rem;">@(string.IsNullOrEmpty(context.BoundingBox) ? "—" : context.BoundingBox)</span>
                        </TemplateColumn>
                        <TemplateColumn Title="Render">
                            <span class="@FileRenderPillClass(context.RenderStatus)">@context.RenderStatus</span>
                        </TemplateColumn>
                        <TemplateColumn Title="">
                            <FluentAnchor Href="@($"/api/v1/models/files/{context.Id}")"
                                          Target="_blank"
                                          Appearance="Appearance.Hypertext">
                                Download
                            </FluentAnchor>
                        </TemplateColumn>
                    </FluentDataGrid>
                </div>
            }
            else if (!_canDownload)
            {
                <FluentMessageBar Intent="MessageIntent.Warning">
                    File details and downloads require Download access.
                </FluentMessageBar>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    [Inject] AdminAuthHelper AuthHelper { get; set; } = null!;
    [Inject] IDbContextFactory<CatalogDbContext> DbFactory { get; set; } = null!;
    [Inject] NavigationManager Nav { get; set; } = null!;
    [Inject] IToastService Toast { get; set; } = null!;
    [Inject] IDialogService Dialog { get; set; } = null!;
    [Inject] IRenderQueue RenderQueue { get; set; } = null!;

    // ---- page state ----
    private Catalog3d.Domain.Entities.Model? _model;
    private Catalog3d.Domain.Entities.Collection? _collection;
    private List<Catalog3d.Domain.Entities.ModelFile> _stlFiles = new();
    private bool _thumbnailAvailable;
    private bool _loading = true;
    private bool _isAdmin;
    private bool _canDownload;

    // ---- action state ----
    private bool _retriggering;
    private bool _deleting;

    protected override async Task OnInitializedAsync()
    {
        await AuthHelper.InitializeAsync();

        await using var db = await DbFactory.CreateDbContextAsync();

        _model = await db.Models
            .AsNoTracking()
            .Include(m => m.Files)
            .FirstOrDefaultAsync(m => m.Slug == Slug);

        if (_model is null)
        {
            _loading = false;
            return;
        }

        // Verify the caller has at least Preview on the collection (invisible = 404 behaviour).
        bool hasPreview = await AuthHelper.HasCollectionRoleAsync(_model.CollectionId, CollectionRole.Preview);
        if (!hasPreview)
        {
            // Treat as not found — same behaviour as the REST API.
            _model = null;
            _loading = false;
            return;
        }

        _collection = await db.Collections
            .AsNoTracking()
            .FirstOrDefaultAsync(c => c.Id == _model.CollectionId);

        _canDownload = await AuthHelper.HasCollectionRoleAsync(_model.CollectionId, CollectionRole.Download);
        _isAdmin     = await AuthHelper.IsCollectionAdminAsync(_model.CollectionId);

        // STL files only — thumbnail is Preview-gated separately via the <img> src endpoint.
        _stlFiles = _model.Files
            .Where(f => f.Kind == Catalog3d.Domain.Entities.ModelFileKind.Stl)
            .OrderBy(f => f.CreatedAt)
            .ToList();

        _thumbnailAvailable = _model.Files
            .Any(f => f.Kind == Catalog3d.Domain.Entities.ModelFileKind.Thumbnail
                   && f.RenderStatus == Catalog3d.Domain.Entities.RenderStatus.Complete);

        _loading = false;
    }

    // ---- admin actions ----

    private async Task RetriggerRenderAsync()
    {
        if (_model is null || _stlFiles.Count == 0) return;

        _retriggering = true;
        try
        {
            // Enqueue a new render job for each STL file. IRenderQueue handles dedup/idempotency.
            foreach (var file in _stlFiles)
            {
                await RenderQueue.EnqueueAsync(file.Id);
            }

            // Reset model status to Processing so the UI reflects the re-queue.
            await using var db = await DbFactory.CreateDbContextAsync();
            var model = await db.Models.FirstOrDefaultAsync(m => m.Id == _model.Id);
            if (model is not null)
            {
                model.Status = ModelStatus.Processing;
                model.UpdatedAt = DateTimeOffset.UtcNow;
                await db.SaveChangesAsync();
                // Reflect updated status in the local snapshot (class, not record — mutate directly).
                _model.Status = ModelStatus.Processing;
                _model.UpdatedAt = model.UpdatedAt;
            }

            Toast.ShowSuccess("Render job queued.");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to enqueue render: {ex.Message}");
        }
        finally
        {
            _retriggering = false;
        }
    }

    private async Task DeleteModelAsync()
    {
        if (_model is null) return;

        var dialogRef = await Dialog.ShowConfirmationAsync(
            $"Delete model '{_model.Name}'? This cannot be undone.",
            primaryText: "Delete",
            secondaryText: "Cancel",
            title: "Confirm delete");

        var result = await dialogRef.Result;
        if (result.Cancelled) return;

        _deleting = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var model = await db.Models
                .Include(m => m.Files)
                .FirstOrDefaultAsync(m => m.Id == _model.Id);

            if (model is not null)
            {
                db.ModelFiles.RemoveRange(model.Files);
                db.Models.Remove(model);
                await db.SaveChangesAsync();
            }

            Toast.ShowSuccess($"Model '{_model.Name}' deleted.");
            Nav.NavigateTo($"/collections/{_collection?.Slug ?? Slug}");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Delete failed: {ex.Message}");
            _deleting = false;
        }
    }

    // ---- formatting helpers ----

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1_073_741_824 => $"{bytes / 1_073_741_824.0:F1} GB",
        >= 1_048_576     => $"{bytes / 1_048_576.0:F1} MB",
        >= 1_024         => $"{bytes / 1_024.0:F1} KB",
        _                => $"{bytes} B",
    };

    private static string ModelStatusPillClass(ModelStatus s) => s switch
    {
        ModelStatus.Ready      => "status-pill status-ready",
        ModelStatus.Processing => "status-pill status-processing",
        ModelStatus.Failed     => "status-pill status-failed",
        _                      => "status-pill status-pending"
    };

    private static string FileRenderPillClass(Catalog3d.Domain.Entities.RenderStatus s) => s switch
    {
        Catalog3d.Domain.Entities.RenderStatus.Complete   => "status-pill status-ready",
        Catalog3d.Domain.Entities.RenderStatus.Processing => "status-pill status-processing",
        Catalog3d.Domain.Entities.RenderStatus.Failed     => "status-pill status-failed",
        _                                                  => "status-pill status-pending"
    };
}
