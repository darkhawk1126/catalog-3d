@page "/collections/{Slug}"
@namespace Catalog3d.Web.Blazor.Admin.Pages
@attribute [Authorize]
@using Catalog3d.Domain.Entities

<PageTitle>@(_collection?.Name ?? Slug) — catalog-3d</PageTitle>

@if (_loading)
{
    <div style="display: flex; justify-content: center; padding: 4rem;">
        <FluentProgressRing Style="width: 36px; height: 36px;" />
    </div>
}
else if (_collection is null)
{
    <div class="c3d-empty-state" style="margin-top: 2rem;">
        <div class="c3d-empty-state-icon"><FluentIcon Value="@(new Size48.Folder())" /></div>
        <p class="c3d-empty-state-title">Collection not found</p>
        <p class="c3d-empty-state-desc">This collection doesn't exist or you don't have access.</p>
        <FluentAnchor Href="/collections" Appearance="Appearance.Accent">Back to Collections</FluentAnchor>
    </div>
}
else
{
    @* Page header *@
    <div class="c3d-page-header">
        <div class="col-header-left">
            <nav class="c3d-breadcrumb">
                <a href="/collections">Collections</a>
                <span class="c3d-breadcrumb-sep">/</span>
                <span class="c3d-breadcrumb-current">@_collection.Name</span>
            </nav>
            <h1 class="c3d-page-title">@_collection.Name</h1>
        </div>

        <div class="col-header-actions">
            @if (_isAdmin)
            {
                <FluentButton Appearance="Appearance.Neutral"
                              IconStart="@(new Size20.Edit())"
                              OnClick="@(() => Nav.NavigateTo($"/collections/{Slug}/edit"))">
                    Edit
                </FluentButton>
                <FluentButton Appearance="Appearance.Neutral"
                              IconStart="@(new Size20.PeopleTeam())"
                              OnClick="@(() => Nav.NavigateTo($"/collections/{Slug}/roles"))">
                    Manage Roles
                </FluentButton>
            }
            @if (_canUpload)
            {
                <FluentButton Appearance="Appearance.Accent"
                              IconStart="@(new Size20.ArrowUpload())"
                              OnClick="@(() => Nav.NavigateTo($"/collections/{Slug}/upload"))">
                    Upload Model
                </FluentButton>
            }
        </div>
    </div>

    @* Collection metadata card *@
    <div class="col-meta-card">
        <div class="c3d-meta-row">
            <span class="c3d-meta-key">Slug</span>
            <code>@_collection.Slug</code>
        </div>
        <div class="c3d-meta-row">
            <span class="c3d-meta-key">Your Role</span>
            <span class="@RolePillClass(_effectiveRole)">@(_effectiveRole?.ToString() ?? "—")</span>
        </div>
        <div class="c3d-meta-row">
            <span class="c3d-meta-key">Created</span>
            <span class="c3d-meta-val">@_collection.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</span>
        </div>
        @if (!string.IsNullOrWhiteSpace(_collection.Description))
        {
            <div class="c3d-meta-row">
                <span class="c3d-meta-key">Description</span>
                <span class="c3d-meta-val">@_collection.Description</span>
            </div>
        }
    </div>

    @* Models section *@
    <div class="models-section-header">
        <span class="c3d-section-label">Models (@_models.Count)</span>
    </div>

    @if (_models.Count == 0)
    {
        <div class="c3d-empty-state">
            <div class="c3d-empty-state-icon"><FluentIcon Value="@(new Size48.Cube())" /></div>
            <p class="c3d-empty-state-title">No models yet</p>
            <p class="c3d-empty-state-desc">Upload your first STL to populate this collection.</p>
            @if (_canUpload)
            {
                <FluentButton Appearance="Appearance.Accent"
                              IconStart="@(new Size20.ArrowUpload())"
                              OnClick="@(() => Nav.NavigateTo($"/collections/{Slug}/upload"))">
                    Upload Model
                </FluentButton>
            }
        </div>
    }
    else
    {
        <div class="c3d-card-grid">
            @foreach (var model in _models)
            {
                <a href="/models/@model.Slug" class="c3d-model-card">
                    <div class="c3d-model-card-thumb">
                        @if (model.HasThumbnail)
                        {
                            <img src="/api/v1/models/@model.Slug/thumbnail"
                                 alt="@model.Name thumbnail"
                                 loading="lazy" />
                        }
                        else
                        {
                            <div class="c3d-model-card-thumb-empty">
                                <FluentIcon Value="@(new Size48.Cube())" />
                                <span class="meta-mono" style="font-size: 0.65rem;">
                                    @ThumbStateLabel(model.Status)
                                </span>
                            </div>
                        }
                    </div>
                    <div class="c3d-model-card-body">
                        <span class="c3d-model-card-name">@model.Name</span>
                        <div class="c3d-model-card-meta">
                            <span class="@StatusPillClass(model.Status)">@StatusLabel(model.Status)</span>
                            <span class="c3d-model-card-date">@model.UpdatedDisplay</span>
                        </div>
                        <span class="meta-mono" style="font-size: 0.7rem;">@model.FileCount file@(model.FileCount != 1 ? "s" : "")</span>
                    </div>
                </a>
            }
        </div>
    }
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    [Inject] AdminAuthHelper AuthHelper { get; set; } = null!;
    [Inject] IDbContextFactory<CatalogDbContext> DbFactory { get; set; } = null!;
    [Inject] NavigationManager Nav { get; set; } = null!;

    private bool _loading = true;
    private bool _isAdmin;
    private bool _canUpload;
    private CollectionRole? _effectiveRole;
    private Collection? _collection;
    private List<ModelRow> _models = new();

    private sealed record ModelRow(
        Guid Id,
        string Name,
        string Slug,
        ModelStatus Status,
        int FileCount,
        bool HasThumbnail,
        string UpdatedDisplay);

    protected override async Task OnInitializedAsync()
    {
        await AuthHelper.InitializeAsync();

        await using var db = await DbFactory.CreateDbContextAsync();

        _collection = await db.Collections
            .AsNoTracking()
            .FirstOrDefaultAsync(c => c.Slug == Slug);

        if (_collection is null)
        {
            _loading = false;
            return;
        }

        // H1: gate on Preview — callers without at least Preview see the same not-found
        // state as a missing collection (404-invisibility, mirrors ModelDetail.razor).
        bool hasPreview = await AuthHelper.HasCollectionRoleAsync(_collection.Id, CollectionRole.Preview);
        if (!hasPreview)
        {
            _collection = null;
            _loading = false;
            return;
        }

        _isAdmin = await AuthHelper.IsCollectionAdminAsync(_collection.Id);
        _canUpload = _isAdmin || await AuthHelper.HasCollectionRoleAsync(_collection.Id, CollectionRole.Uploader);

        // Resolve effective role for display.
        _effectiveRole = _isAdmin ? CollectionRole.Admin
            : _canUpload ? CollectionRole.Uploader
            : await AuthHelper.HasCollectionRoleAsync(_collection.Id, CollectionRole.Download) ? CollectionRole.Download
            : await AuthHelper.HasCollectionRoleAsync(_collection.Id, CollectionRole.Preview) ? CollectionRole.Preview
            : null;

        // Load models with file counts and thumbnail presence.
        var modelData = await db.Models
            .AsNoTracking()
            .Where(m => m.CollectionId == _collection.Id)
            .OrderBy(m => m.Name)
            .Select(m => new
            {
                m.Id,
                m.Name,
                m.Slug,
                m.Status,
                m.UpdatedAt,
                FileCount = m.Files.Count(),
                HasThumbnail = m.Files.Any(f => f.Kind == ModelFileKind.Thumbnail && f.RenderStatus == RenderStatus.Complete)
            })
            .ToListAsync();

        _models = modelData
            .Select(m => new ModelRow(
                m.Id,
                m.Name,
                m.Slug,
                m.Status,
                m.FileCount,
                m.HasThumbnail,
                m.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd")))
            .ToList();

        _loading = false;
    }

    private static string StatusLabel(ModelStatus status) => status switch
    {
        ModelStatus.Ready      => "Ready",
        ModelStatus.Processing => "Processing",
        ModelStatus.Failed     => "Failed",
        _                      => status.ToString()
    };

    private static string StatusPillClass(ModelStatus status) => status switch
    {
        ModelStatus.Ready      => "status-pill status-ready",
        ModelStatus.Processing => "status-pill status-processing",
        ModelStatus.Failed     => "status-pill status-failed",
        _                      => "status-pill status-pending"
    };

    private static string ThumbStateLabel(ModelStatus status) => status switch
    {
        ModelStatus.Processing => "rendering…",
        ModelStatus.Failed     => "render failed",
        _                      => "no thumbnail"
    };

    private static string RolePillClass(CollectionRole? role) => role switch
    {
        CollectionRole.Admin    => "status-pill status-ready",
        CollectionRole.Uploader => "status-pill status-processing",
        CollectionRole.Download => "status-pill status-pending",
        CollectionRole.Preview  => "status-pill status-pending",
        _                       => "meta-mono"
    };
}
