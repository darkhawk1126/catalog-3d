@page "/"
@namespace Catalog3d.Web.Blazor.Admin.Pages
@attribute [Authorize]
@using Catalog3d.Web.Blazor.Auth
@using Catalog3d.Domain.Entities

@* Dashboard — landing page for all authenticated users.
   Stats are scoped: site-admins see totals across all collections;
   collection-scoped users see counts for their accessible collections only. *@

<PageTitle>Dashboard — catalog-3d</PageTitle>

@if (_loading)
{
    <div class="dashboard-loading">
        <FluentProgressRing Style="width: 36px; height: 36px;" />
    </div>
}
else
{
    <div class="dashboard-header">
        <h1 class="c3d-page-title">Dashboard</h1>
    </div>

    <div class="stats-grid">
        <div class="c3d-stat-card">
            <div class="c3d-stat-icon-wrap">
                <FluentIcon Value="@(new Size20.AppFolder())" />
            </div>
            <span class="c3d-stat-value">@_collectionCount</span>
            <span class="c3d-stat-label">Collections</span>
        </div>

        <div class="c3d-stat-card">
            <div class="c3d-stat-icon-wrap">
                <FluentIcon Value="@(new Size20.CubeTree())" />
            </div>
            <span class="c3d-stat-value">@_modelCount</span>
            <span class="c3d-stat-label">Models</span>
        </div>

        <div class="c3d-stat-card stat-card-processing">
            <div class="c3d-stat-icon-wrap">
                <FluentIcon Value="@(new Size20.ArrowSync())" />
            </div>
            <span class="c3d-stat-value">@_pendingRenders</span>
            <span class="c3d-stat-label">Pending Renders</span>
        </div>

        <div class="c3d-stat-card @(_failedRenders > 0 ? "stat-card-failed" : "")">
            <div class="c3d-stat-icon-wrap @(_failedRenders > 0 ? "stat-icon-failed" : "")">
                <FluentIcon Value="@(new Size20.ErrorCircle())" />
            </div>
            <span class="c3d-stat-value @(_failedRenders > 0 ? "stat-value-failed" : "")">@_failedRenders</span>
            <span class="c3d-stat-label">Failed Renders</span>
        </div>
    </div>

    @if (_recentModels.Count > 0)
    {
        <section class="recent-section">
            <span class="c3d-section-label">Recent Uploads</span>

            <div class="recent-table-wrap">
                <FluentDataGrid Items="@_recentModels.AsQueryable()"
                                GridTemplateColumns="1fr 1fr auto auto"
                                TGridItem="RecentModelRow">
                    <PropertyColumn Title="Model" Property="@(m => m.Name)" />
                    <PropertyColumn Title="Collection" Property="@(m => m.CollectionName)" />
                    <TemplateColumn Title="Status">
                        <span class="@StatusPillClass(context.Status)">@StatusLabel(context.Status)</span>
                    </TemplateColumn>
                    <TemplateColumn Title="Uploaded">
                        <span class="meta-mono" title="@context.CreatedAt.ToString("u")">
                            @FormatRelative(context.CreatedAt)
                        </span>
                    </TemplateColumn>
                </FluentDataGrid>
            </div>
        </section>
    }
    else
    {
        <div class="c3d-empty-state" style="margin-top: 2rem;">
            <div class="c3d-empty-state-icon">
                <FluentIcon Value="@(new Size48.Cube())" />
            </div>
            <p class="c3d-empty-state-title">No models yet</p>
            <p class="c3d-empty-state-desc">Upload your first STL to a collection to get started.</p>
            <FluentAnchor Href="/collections" Appearance="Appearance.Accent">Browse collections</FluentAnchor>
        </div>
    }
}

@code {
    [Inject] AdminAuthHelper AuthHelper { get; set; } = null!;
    [Inject] IDbContextFactory<CatalogDbContext> DbFactory { get; set; } = null!;
    [Inject] ICollectionAuthorizationService CollectionAuthService { get; set; } = null!;
    [Inject] IConfiguration Configuration { get; set; } = null!;

    private bool _loading = true;
    private int _collectionCount;
    private int _modelCount;
    private int _pendingRenders;
    private int _failedRenders;
    private List<RecentModelRow> _recentModels = [];

    protected override async Task OnInitializedAsync()
    {
        await AuthHelper.InitializeAsync();

        await using var db = await DbFactory.CreateDbContextAsync();

        if (AuthHelper.IsSiteAdmin())
        {
            _collectionCount = await db.Collections.CountAsync();
            _modelCount      = await db.Models.CountAsync();
            _pendingRenders  = await db.ModelFiles
                .CountAsync(f => f.Kind == ModelFileKind.Stl
                              && (f.RenderStatus == RenderStatus.Pending
                                  || f.RenderStatus == RenderStatus.Processing));
            _failedRenders   = await db.ModelFiles
                .CountAsync(f => f.Kind == ModelFileKind.Stl
                              && f.RenderStatus == RenderStatus.Failed);

            _recentModels = await db.Models
                .AsNoTracking()
                .OrderByDescending(m => m.CreatedAt)
                .Take(10)
                .Select(m => new RecentModelRow(m.Name, m.Collection.Name, m.Status, m.CreatedAt))
                .ToListAsync();
        }
        else if (AuthHelper.IsAuthenticated)
        {
            var userContext = new ClaimsPrincipalUserContext(
                AuthHelper.User!, Configuration["Auth:Provider"] ?? "Dev");

            var accessibleIds = await CollectionAuthService
                .GetAuthorizedCollectionIdsAsync(userContext, CollectionRole.Preview);

            if (accessibleIds.Count > 0)
            {
                _collectionCount = accessibleIds.Count;
                _modelCount      = await db.Models
                    .CountAsync(m => accessibleIds.Contains(m.CollectionId));
                _pendingRenders  = await db.ModelFiles
                    .CountAsync(f => accessibleIds.Contains(f.Model.CollectionId)
                                  && f.Kind == ModelFileKind.Stl
                                  && (f.RenderStatus == RenderStatus.Pending
                                      || f.RenderStatus == RenderStatus.Processing));
                _failedRenders   = await db.ModelFiles
                    .CountAsync(f => accessibleIds.Contains(f.Model.CollectionId)
                                  && f.Kind == ModelFileKind.Stl
                                  && f.RenderStatus == RenderStatus.Failed);

                _recentModels = await db.Models
                    .AsNoTracking()
                    .Where(m => accessibleIds.Contains(m.CollectionId))
                    .OrderByDescending(m => m.CreatedAt)
                    .Take(10)
                    .Select(m => new RecentModelRow(m.Name, m.Collection.Name, m.Status, m.CreatedAt))
                    .ToListAsync();
            }
        }

        _loading = false;
    }

    private static string FormatRelative(DateTimeOffset dt)
    {
        var diff = DateTimeOffset.UtcNow - dt;
        return diff switch
        {
            { TotalMinutes: < 1 }  => "just now",
            { TotalMinutes: < 60 } => $"{(int)diff.TotalMinutes}m ago",
            { TotalHours:   < 24 } => $"{(int)diff.TotalHours}h ago",
            { TotalDays:    < 7  } => $"{(int)diff.TotalDays}d ago",
            _                      => dt.ToString("MMM d, yyyy"),
        };
    }

    private static string StatusLabel(ModelStatus status) => status switch
    {
        ModelStatus.Ready      => "Ready",
        ModelStatus.Processing => "Processing",
        ModelStatus.Failed     => "Failed",
        _                      => status.ToString()
    };

    private static string StatusPillClass(ModelStatus status) => status switch
    {
        ModelStatus.Ready      => "status-pill status-ready",
        ModelStatus.Processing => "status-pill status-processing",
        ModelStatus.Failed     => "status-pill status-failed",
        _                      => "status-pill status-pending"
    };

    private sealed record RecentModelRow(
        string Name,
        string CollectionName,
        ModelStatus Status,
        DateTimeOffset CreatedAt);
}
