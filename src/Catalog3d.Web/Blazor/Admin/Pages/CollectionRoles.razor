@page "/collections/{Slug}/roles"
@namespace Catalog3d.Web.Blazor.Admin.Pages
@attribute [Authorize]
@using Catalog3d.Domain.Entities

<PageTitle>Roles — @(_collection?.Name ?? Slug) — catalog-3d</PageTitle>

@if (_loading)
{
    <FluentProgressRing />
}
else if (_collection is null)
{
    <FluentMessageBar Intent="MessageIntent.Error">Collection not found.</FluentMessageBar>
}
else
{
    <div class="page-header">
        <div class="page-header-title">
            <nav class="c3d-breadcrumb">
                <a href="/collections">Collections</a>
                <span class="c3d-breadcrumb-sep">/</span>
                <a href="/collections/@Slug">@_collection.Name</a>
                <span class="c3d-breadcrumb-sep">/</span>
                <span class="c3d-breadcrumb-current">Roles</span>
            </nav>
            <h1 class="c3d-page-title">Role Assignments</h1>
        </div>
        <FluentButton Appearance="Appearance.Outline"
                      IconStart="@(new Size20.ArrowLeft())"
                      OnClick="@(() => Nav.NavigateTo($"/collections/{Slug}"))">
            Back
        </FluentButton>
    </div>

    @* ─── Existing assignments ─────────────────────────────────────────── *@
    <section class="assignments-section">
        <FluentLabel Typo="Typography.H6" Class="section-heading">Current Assignments</FluentLabel>

        @if (_assignments.Count == 0)
        {
            <FluentMessageBar Intent="MessageIntent.Info">
                No role assignments yet. Site-admins always hold Admin implicitly.
            </FluentMessageBar>
        }
        else
        {
            <FluentDataGrid Items="@_assignments.AsQueryable()"
                            TGridItem="RoleAssignment"
                            GridTemplateColumns="1fr 160px 56px"
                            Class="assignments-grid">
                <TemplateColumn Title="User / Group">
                    <div class="principal-cell">
                        <span class="principal-label">@PrincipalLabel(context.Principal)</span>
                        <code class="principal-sub">@context.Principal</code>
                    </div>
                </TemplateColumn>
                <TemplateColumn Title="Role">
                    <span class="@RolePillClass(context.Role)">
                        @context.Role.ToString()
                    </span>
                </TemplateColumn>
                <TemplateColumn Title="" Align="Align.End">
                    <FluentButton Appearance="Appearance.Lightweight"
                                  IconStart="@(new Size20.Delete())"
                                  Title="Remove assignment"
                                  OnClick="@(() => RemoveAssignmentAsync(context))" />
                </TemplateColumn>
            </FluentDataGrid>
        }
    </section>

    @* ─── Add assignment form ──────────────────────────────────────────── *@
    <section class="add-section">
        <FluentLabel Typo="Typography.H6" Class="section-heading">Add Assignment</FluentLabel>

        <FluentCard Class="add-card">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">

                <FluentSelect TOption="string"
                              @bind-Value="_principalKind"
                              Label="Assign to"
                              Style="width: 200px;">
                    <FluentOption TOption="string" Value="@("user")">A user</FluentOption>
                    <FluentOption TOption="string" Value="@("group")">A group</FluentOption>
                </FluentSelect>

                @if (_principalKind == "group")
                {
                    <FluentTextField @bind-Value="_groupName"
                                     Label="Group name"
                                     Placeholder="media"
                                     Style="width: 100%;" />
                    <FluentLabel Class="helper-text">
                        Enter an OIDC group name — the <code>group:</code> prefix is added for you.
                        @if (_groups.Count > 0)
                        {
                            <text> Seen groups: @string.Join(", ", _groups.Select(g => g["group:".Length..]))</text>
                        }
                    </FluentLabel>
                }
                else if (_users.Count == 0)
                {
                    <FluentMessageBar Intent="MessageIntent.Info">
                        No users have signed in to catalog-3d yet, so there's nobody to pick.
                        A user appears here automatically the first time they log in.
                    </FluentMessageBar>
                }
                else
                {
                    <FluentSelect TOption="string"
                                  @bind-Value="_selectedUserPrincipal"
                                  Label="User"
                                  Style="width: 100%;">
                        <FluentOption TOption="string" Value="@("")">Select a user…</FluentOption>
                        @foreach (var u in _users)
                        {
                            <FluentOption TOption="string" Value="@u.Principal">@UserOptionLabel(u)</FluentOption>
                        }
                    </FluentSelect>
                    <FluentLabel Class="helper-text">
                        One principal holds at most one role per collection; assigning again
                        replaces the existing role.
                    </FluentLabel>
                }

                <FluentSelect TOption="string"
                              @bind-Value="_newRoleStr"
                              Label="Role"
                              Style="width: 200px;">
                    @foreach (var role in _allRoles)
                    {
                        <FluentOption TOption="string" Value="@role.ToString()">@role.ToString()</FluentOption>
                    }
                </FluentSelect>

                @if (!string.IsNullOrWhiteSpace(_addError))
                {
                    <FluentMessageBar Intent="MessageIntent.Error">@_addError</FluentMessageBar>
                }

                <div>
                    <FluentButton Appearance="Appearance.Accent"
                                  IconStart="@(new Size20.Add())"
                                  OnClick="@AddAssignmentAsync"
                                  Loading="@_saving">
                        Add / Update
                    </FluentButton>
                </div>
            </FluentStack>
        </FluentCard>
    </section>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    [Inject] AdminAuthHelper AuthHelper { get; set; } = null!;
    [Inject] IDbContextFactory<CatalogDbContext> DbFactory { get; set; } = null!;
    [Inject] IUserDirectory Directory { get; set; } = null!;
    [Inject] NavigationManager Nav { get; set; } = null!;
    [Inject] IToastService Toast { get; set; } = null!;
    [Inject] IDialogService Dialog { get; set; } = null!;

    private Catalog3d.Domain.Entities.Collection? _collection;
    private List<RoleAssignment> _assignments = new();
    private bool _loading = true;
    private bool _saving;

    // Picker source (captured directory) + friendly-name map for existing rows.
    private List<DirectoryUser> _users = new();
    private List<string> _groups = new();
    private Dictionary<string, string> _labels = new(StringComparer.OrdinalIgnoreCase);

    private string _principalKind = "user";        // "user" | "group"
    private string _selectedUserPrincipal = string.Empty;
    private string _groupName = string.Empty;
    private string _newRoleStr = nameof(CollectionRole.Preview);
    private string _addError = string.Empty;

    private static readonly CollectionRole[] _allRoles =
        Enum.GetValues<CollectionRole>();

    protected override async Task OnInitializedAsync()
    {
        await AuthHelper.InitializeAsync();

        await using var db = await DbFactory.CreateDbContextAsync();

        _collection = await db.Collections
            .AsNoTracking()
            .FirstOrDefaultAsync(c => c.Slug == Slug);

        if (_collection is null)
        {
            _loading = false;
            return;
        }

        bool isAdmin = await AuthHelper.IsCollectionAdminAsync(_collection.Id);
        if (!isAdmin)
        {
            Nav.NavigateTo($"/collections/{Slug}");
            return;
        }

        // Load the picker source (users seen signing in + groups observed on their tokens).
        _users = (await Directory.ListUsersAsync()).ToList();
        _groups = (await Directory.ListGroupsAsync()).ToList();

        await LoadAssignmentsAsync(db);
        _loading = false;
    }

    private async Task LoadAssignmentsAsync(CatalogDbContext db)
    {
        _assignments = await db.RoleAssignments
            .AsNoTracking()
            .Where(r => r.CollectionId == _collection!.Id)
            .OrderBy(r => r.Principal)
            .ToListAsync();

        await RefreshLabelsAsync();
    }

    // Resolve each assignment's principal to a friendly label for display.
    private async Task RefreshLabelsAsync()
    {
        var resolved = await Directory.ResolveLabelsAsync(_assignments.Select(a => a.Principal));
        _labels = new Dictionary<string, string>(resolved, StringComparer.OrdinalIgnoreCase);
    }

    private string PrincipalLabel(string principal) =>
        _labels.TryGetValue(principal, out var label) ? label : principal;

    private static string UserOptionLabel(DirectoryUser u)
    {
        var display = string.IsNullOrWhiteSpace(u.DisplayName) ? u.Username : u.DisplayName;
        if (string.IsNullOrWhiteSpace(display)) return u.Principal;
        return !string.IsNullOrWhiteSpace(u.Username)
            && !string.Equals(u.Username, display, StringComparison.OrdinalIgnoreCase)
                ? $"{display} ({u.Username})"
                : display;
    }

    private async Task AddAssignmentAsync()
    {
        _addError = string.Empty;

        // Build the principal from the picker: a selected user already carries its "user:<sub>"
        // form; a group name gets the "group:" prefix added here.
        string principal;
        if (_principalKind == "group")
        {
            var name = _groupName.Trim();
            if (string.IsNullOrWhiteSpace(name))
            {
                _addError = "Enter a group name.";
                return;
            }
            principal = name.StartsWith("group:", StringComparison.OrdinalIgnoreCase) ? name : "group:" + name;
        }
        else
        {
            if (string.IsNullOrWhiteSpace(_selectedUserPrincipal))
            {
                _addError = "Select a user.";
                return;
            }
            principal = _selectedUserPrincipal;
        }

        // M1: normalize to lower-case at write so DB rows are consistently cased,
        // making the EF IN-clause match independent of column collation.
        principal = principal.ToLowerInvariant();

        if (!Enum.TryParse<CollectionRole>(_newRoleStr, out var role))
        {
            _addError = "Invalid role selection.";
            return;
        }

        _saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // Upsert: remove existing row first (composite PK prevents plain Add clash).
            var existing = await db.RoleAssignments
                .FirstOrDefaultAsync(r => r.CollectionId == _collection!.Id && r.Principal == principal);

            if (existing is not null)
            {
                existing.Role = role;
            }
            else
            {
                db.RoleAssignments.Add(new RoleAssignment
                {
                    CollectionId = _collection!.Id,
                    Principal = principal,
                    Role = role
                });
            }

            await db.SaveChangesAsync();

            // Friendly confirmation: use the picked user's label when available.
            var label = _users.FirstOrDefault(u =>
                string.Equals(u.Principal, principal, StringComparison.OrdinalIgnoreCase)) is { } picked
                ? UserOptionLabel(picked)
                : principal;
            Toast.ShowSuccess($"Assigned {role} to {label}.");

            _selectedUserPrincipal = string.Empty;
            _groupName = string.Empty;

            // Refresh list from a new context.
            await using var db2 = await DbFactory.CreateDbContextAsync();
            await LoadAssignmentsAsync(db2);
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Save failed: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RemoveAssignmentAsync(RoleAssignment assignment)
    {
        var dialogRef = await Dialog.ShowConfirmationAsync(
            $"Remove {assignment.Role} from \"{assignment.Principal}\"?",
            primaryText: "Remove",
            secondaryText: "Cancel",
            title: "Confirm Remove");

        var result = await dialogRef.Result;
        if (result.Cancelled) return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var row = await db.RoleAssignments
                .FirstOrDefaultAsync(r => r.CollectionId == _collection!.Id && r.Principal == assignment.Principal);

            if (row is not null)
            {
                db.RoleAssignments.Remove(row);
                await db.SaveChangesAsync();
                Toast.ShowSuccess($"Removed {assignment.Role} from {assignment.Principal}.");

                await using var db2 = await DbFactory.CreateDbContextAsync();
                await LoadAssignmentsAsync(db2);
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Remove failed: {ex.Message}");
        }
    }

    private static string RolePillClass(CollectionRole role) => role switch
    {
        CollectionRole.Admin    => "status-pill status-ready",
        CollectionRole.Uploader => "status-pill status-processing",
        CollectionRole.Download => "status-pill status-pending",
        CollectionRole.Preview  => "status-pill status-pending",
        _                       => "meta-mono"
    };
}
