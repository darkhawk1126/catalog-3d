@inherits LayoutComponentBase
@namespace Catalog3d.Web.Blazor.Admin

@* FluentMainLayout provides the top-level chrome: header bar + collapsible nav + body area.
   FluentToastProvider and FluentDialogProvider must be inside the layout so they are present
   for every page. The providers are singletons on the Blazor circuit; placing them here
   ensures a single instance for the entire admin SPA. *@

<FluentMainLayout NavMenuTitle="catalog-3d" NavMenuWidth="220" HeaderHeight="50">
    <Header>
        <AdminHeader />
    </Header>
    <NavMenuContent>
        <AdminNavMenu />
    </NavMenuContent>
    <Body>
        <FluentToastProvider MaxToastCount="5" Position="ToastPosition.TopRight" />
        <FluentDialogProvider />
        <article class="content">
            @Body
        </article>
    </Body>
</FluentMainLayout>

<FluentDesignTheme @bind-Mode="@_themeMode"
                  CustomColor="@_accentColor"
                  NeutralBaseColor="#1A1D21"
                  StorageName="catalog3d-theme" />

@code {
    // Default to Dark — the three.js viewer is always dark and the shell
    // must harmonize with it on first visit. Users can switch via the toggle.
    private DesignThemeModes _themeMode = DesignThemeModes.Dark;

    // Filament-heat accent (#E8792A) drives all Fluent accent-fill tokens
    // (buttons, active nav, progress rings, badges with Appearance.Accent).
    private const string _accentColor = "#E8792A";
}
